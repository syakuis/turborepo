{
  "name": "turbo-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config": "*",
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "npm@10.1.0"
}
