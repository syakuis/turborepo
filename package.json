{
  "name": "turbo-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "msw:init": "turbo msw:init"
  },
  "type": "module",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ],
    "overrides": {
      "react": "^19.1.1",
      "react-dom": "^19.1.1",
      "@types/react": "^19.1.12",
      "@types/react-dom": "^19.1.9",
      "@types/react-router-dom": "^5.3.3",
      "@vitejs/plugin-react": "^5.0.2",
      "vite-plugin-svgr": "^4.5.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "get-tsconfig": "^4.10.1",
    "globals": "^16.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.11.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.16",
    "tsc-watch": "^7.1.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
