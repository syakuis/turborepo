auto-install-peers = true
# 누락된 "필수(peer)" 의존성이 있으면 pnpm이 자동으로 설치해줌.
# 예: 어떤 패키지가 react를 peerDependencies로 요구하는데 루트에 없으면,
#     알아서 react를 같이 깔아서 peer dependency 에러를 줄여줌.

node-linker = hoisted
# pnpm이 node_modules 구조를 어떻게 만들지 정하는 옵션.
# "hoisted"면 npm/yarn처럼 의존성을 위로 끌어올린 구조로 만들어서,
# 일부 오래된 도구들이 기대하는 전통적인 node_modules 구조에 가깝게 동작함.

shamefully-hoist = true
# 가능한 모든 의존성을 루트 node_modules로 강하게 끌어올림.
# pnpm 특유의 엄격한 구조 대신, "그냥 다 위에 깔려있는" 느낌으로 만들어서
# 의존성 해석이 엉성한 도구/플러그인도 돌아가게 하는 안전빵 모드.

side-effects-cache = false
# 패키지 설치 시 (pre/post)install 스크립트 결과를 캐시하지 않도록 설정.
# true면 빌드 산출물(예: node-gyp 결과 등)을 캐시해서 재설치 시 빠르게 하지만,
# false로 두면 항상 새로 실행해서 캐시 오염/환경 차이 문제를 피할 수 있음.

enable-pre-post-scripts = true
# 패키지의 preinstall, postinstall 같은 스크립트를 실행하도록 허용.
# 일부 환경에선 보안/안정성 때문에 끄기도 하는데,
# 여기서는 설치 과정에서 필요한 빌드/셋업 스크립트가 제대로 돌도록 켠 상태.
